# ─────────────────────────────────────────────────────────────────────────────
# Kenya Amber Alert — Environment variables
# Copy this file to .env and fill in every value marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_in_production          # REQUIRED — strong password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme                           # REQUIRED

# ── Go API ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_random_chars           # REQUIRED — use: openssl rand -hex 32

# ── MinIO (S3-compatible photo storage) ───────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin                    # REQUIRED — change in production

# ── Africa's Talking ──────────────────────────────────────────────────────────
AT_API_KEY=your_at_api_key                        # REQUIRED — from africastalking.com
AT_USERNAME=your_at_username                      # REQUIRED
AT_SHORT_CODE=22384                               # Your registered short code

# ── Laravel ───────────────────────────────────────────────────────────────────
APP_KEY=base64:replace_with_laravel_key           # REQUIRED — php artisan key:generate
APP_URL=https://amberalert.go.ke

# ── Optional overrides ────────────────────────────────────────────────────────
# AMBER_RATE_LIMIT_RPM=120
# AMBER_MAX_UPLOAD_BYTES=10485760
